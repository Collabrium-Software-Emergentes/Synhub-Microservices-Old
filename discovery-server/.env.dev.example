# =========================================
# SPRING PROFILE
# =========================================
SPRING_PROFILES_ACTIVE=dev

# =========================================
# APPLICATION
# =========================================
SERVER_PORT=8761
SPRING_APPLICATION_NAME=discovery-server

# =========================================
# EUREKA
# =========================================
EUREKA_HOSTNAME=localhost
EUREKA_PREFER_IP_ADDRESS=false
EUREKA_SERVICE_URL=http://localhost:8761/eureka/
EUREKA_ZONE=default

# =========================================
# APPLICATION INFO
# =========================================
APPLICATION_VERSION=1.0.0
APPLICATION_DESCRIPTION='Collabrium Discovery Server'

# =========================================
# MANAGEMENT
# =========================================
MANAGEMENT_BASE_PATH=/actuator