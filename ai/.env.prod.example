# =========================================
# SPRING PROFILE
# =========================================
SPRING_PROFILES_ACTIVE=prod

# =========================================
# APPLICATION
# =========================================
PORT=8088

# =========================================
# EUREKA
# =========================================
EUREKA_SERVER_URL=http://discovery-server:8761/eureka/
EUREKA_REGISTER=true
EUREKA_FETCH=true
EUREKA_PREFER_IP=true

# =========================================
# JWT
# =========================================
JWT_SECRET=collabrium-development-secret-key-256-bits-long
JWT_ISSUER=collabrium
JWT_AUDIENCE=collabrium-platform

# =========================================
# LM-STUDIO
# =========================================
OPENAI_BASE_URL=http://host.docker.internal:1234
OPENAI_API_KEY=test
OPENAI_MODEL=qwen3-4b-instruct-2507
OPENAI_TEMPERATURE=0.2
OPENAI_MAX_TOKENS=1000
OPENAI_TOP_P=0.9
OPENAI_FREQUENCY_PENALTY=0.0
OPENAI_PRESENCE_PENALTY=0.0

# =========================================
# LOGGING
# =========================================
LOG_LEVEL=INFO
FEIGN_LOG_LEVEL=WARN
SPRING_AI_LOG_LEVEL=WARN

# =========================================
# SWAGGER
# =========================================
SPRINGDOC_API_DOCS_ENABLED=true
SPRINGDOC_SWAGGER_UI_ENABLED=true