# =========================================
# SPRING PROFILE
# =========================================
SPRING_PROFILES_ACTIVE=dev

# =========================================
# APPLICATION
# =========================================
PORT=8086

# =========================================
# JWT
# =========================================
JWT_SECRET=collabrium-super-secret-production-key-with-at-least-64-bytes-for-hs384-jwt-signing
JWT_ISSUER=collabrium
JWT_AUDIENCE=collabrium-platform

# =========================================
# EUREKA
# =========================================
EUREKA_URL=http://discovery-server:8761/eureka/

# =========================================
# RABBITMQ
# =========================================
RABBIT_HOST=rabbitmq
RABBIT_PORT=5672
RABBIT_USER=collabrium
RABBIT_PASSWORD=collabrium
RABBIT_VIRTUAL_HOST=/

# =========================================
# LOGGING
# =========================================
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=DEBUG

# =========================================
# CLOUDINARY
# =========================================
CLOUDINARY_CLOUD_NAME=cloudinary_cloud_name
CLOUDINARY_API_KEY=cloudinary_api_key
CLOUDINARY_API_SECRET=cloduinary_api_secret